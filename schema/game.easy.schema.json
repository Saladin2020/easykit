          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "web",
              "windows",
              "linux",
              "android"
            ]
          }
        },
        "release": {
          "default": "0.1.0",
          "type": "string"
        },
        "itch": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+\\/[a-z0-9_-]+$"
        },
        "androidPackage": {
          "type": "string"
        }
