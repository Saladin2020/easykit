              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              },
              "from": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]*$"
              }
            },
            "required": [
              "id",
              "from"
            ]
          }
        },
        "export": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "export"
      ]
    },
    "sfx": {
      "type": "object",
      "properties": {
        "bank": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
