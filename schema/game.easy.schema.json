  "required": [
    "format",
    "game",
    "sprites",
    "scenes",
    "tilemaps",
    "npcs",
    "dialogue",
    "quests",
    "items",
    "ui",
    "fx",
    "sfx",
    "music",
    "anim",
    "save"
